# Exemplo de arquivo .env para o frontend do QLIK CODEX I.A
# Renomeie para .env na pasta "web" antes de rodar `npm run dev`

# URL base para as APIs usadas no frontend
# Usado em web/src/api/sessionClient.ts (para rotas /sessions, etc.)
VITE_API_BASE_URL=/api

# URL base completa do backend (inclui protocolo e porta)
# Usado em web/src/api/authClient.ts (rotas de autenticação)
VITE_API_URL=http://localhost:3000

# Em ambiente de produção, ajuste estes valores conforme o domínio/porta do backend.

