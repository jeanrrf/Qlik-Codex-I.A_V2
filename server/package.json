{
  "name": "qlik-codex-ia-server",
  "version": "0.2.1",
  "description": "Backend do QLIK CODEX I.A - Otimizador inteligente de scripts Qlik com AINEX.",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "kill": "npx kill-port 3000"
  },
  "keywords": [
    "qlik",
    "qlik-sense",
    "qlikview",
    "ainex",
    "ai-optimization",
    "typescript",
    "express",
    "saas",
    "optimizer"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^0.3.1",
    "@libsql/client": "^0.15.15",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/uuid": "^10.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.0",
    "google-auth-library": "^9.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^7.0.11",
    "typescript": "^5.7.2",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^25.0.1",
    "@types/nodemailer": "^7.0.4",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.13.0",
    "prettier": "^3.4.2",
    "ts-node-dev": "^2.0.0",
    "vitest": "^2.1.4"
