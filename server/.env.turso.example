# Turso Configuration (SQLite na Cloud)
# Obtenha suas credenciais em: https://turso.tech

# 1. Crie conta: turso auth signup
# 2. Crie banco: turso db create qlik-codex-analytics
# 3. Obtenha URL: turso db show qlik-codex-analytics --url
# 4. Obtenha token: turso db tokens create qlik-codex-analytics

# URL do banco Turso
TURSO_DATABASE_URL=libsql://qlik-codex-analytics-[seu-username].turso.io

# Token de autenticação
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9...

