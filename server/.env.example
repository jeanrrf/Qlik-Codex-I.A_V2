# Exemplo de arquivo .env para o backend do QLIK CODEX I.A
# Renomeie para .env antes de rodar `npm run dev`

# Porta do servidor HTTP
PORT=3000

# Ordem de fallback dos provedores (separe por virgula)
# Opcoes validas: google, nvidia
LLM_PROVIDERS=google,nvidia

# Chave de API do Gemini (Google Gen AI)
# Obtenha em: https://ai.google.dev/
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL_NAME=gemini-2.5-flash

# NVIDIA NIM API
# Obtenha em: https://build.nvidia.com/
NVIDIA_API_KEY=sua_chave_nvidia_aqui

# Modelo NVIDIA (unico modelo oficial suportado)
NVIDIA_MODEL_NAME=mistralai/mistral-large-3-675b-instruct-2512

# Turso Database (SQLite cloud) - Obrigatório em produção
# Obtenha em: https://turso.tech/
# 
# Setup rápido:
# 1. Instale: curl -sSfL https://get.tur.so/install.sh | bash
# 2. Login: turso auth login
# 3. Crie DB: turso db create qlik-codex-production
# 4. Obtenha URL: turso db show qlik-codex-production --url
# 5. Gere token: turso db tokens create qlik-codex-production
TURSO_DATABASE_URL=libsql://[your-db].turso.io
TURSO_AUTH_TOKEN=seu_token_turso_aqui

# URLs e CORS
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Auth Cookies (produção: none para cross-domain)
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# Google OAuth 2.0
# Obtenha em: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_secret_aqui
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# JWT Configuration
JWT_SECRET=sua_chave_secreta_forte_e_aleatoria
JWT_EXPIRES_IN=7d

# Owner Access (bypass OAuth para admin)
OWNER_ACCESS_TOKEN=token_secreto_do_proprietario
OWNER_EMAIL=seu-email@gmail.com
