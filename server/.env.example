# Exemplo de arquivo .env para o backend do QLIK CODEX I.A
# Renomeie para .env antes de rodar `npm run dev`

# Porta do servidor HTTP
PORT=3000

# Ordem de fallback dos provedores (separe por virgula)
# Opcoes validas: google, nvidia
LLM_PROVIDERS=google,nvidia

# Chave de API do Gemini (Google Gen AI)
# Obtenha em: https://ai.google.dev/
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL_NAME=gemini-2.5-flash

# Limites de tokens de saída do Gemini
# Default: usado para a maioria das tarefas (padrão: 8192)
GEMINI_MAX_OUTPUT_TOKENS_DEFAULT=8192
# Extended: usado para tarefas que precisam de mais tokens (formatação, documentação, etc.) (padrão: 16384)
GEMINI_MAX_OUTPUT_TOKENS_EXTENDED=16384

# NVIDIA NIM API
# Obtenha em: https://build.nvidia.com/
NVIDIA_API_KEY=sua_chave_nvidia_aqui

# Modelo NVIDIA (unico modelo oficial suportado)
NVIDIA_MODEL_NAME=mistralai/mistral-large-3-675b-instruct-2512

# URL de conexao do PostgreSQL (opcional, para futuras features)
# Exemplo: postgres://usuario:senha@host:5432/qlik_codex
# DATABASE_URL=postgres://usuario:senha@localhost:5432/qlik_codex

# Origem permitida para requisicoes do frontend
CORS_ORIGIN=http://localhost:5173
